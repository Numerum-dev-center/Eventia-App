            "method": "GET",
            "url": { "raw": "{{baseUrl}}/organizer/events/{{eventId}}/billets", "host": ["{{baseUrl}}"], "path": ["organizer", "events", "{{eventId}}", "billets"] },
            "description": "Get ticket categories for a specific event"
          }
        },
        {
          "name": "Get Event Finance",
