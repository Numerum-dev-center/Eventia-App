    {
      "name": "Tickets",
      "description": "Billets avec QR code crypto",
      "item": [
        {
          "name": "Créer tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (Array.isArray(json) && json[0] && json[0].id) { pm.collectionVariables.set('ticketId', json[0].id); }"
                ]
              }
            }
          ],
