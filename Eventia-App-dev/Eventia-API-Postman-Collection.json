            "url": { "raw": "{{baseUrl}}/organizer/events/{{eventId}}/finance", "host": ["{{baseUrl}}"], "path": ["organizer", "events", "{{eventId}}", "finance"] },
            "description": "Get financial stats for a specific event"
          }
        },
        {
          "name": "Get Event Access Logs",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/organizer/events/{{eventId}}/acces", "host": ["{{baseUrl}}"], "path": ["organizer", "events", "{{eventId}}", "acces"] },
            "description": "Get access control logs for a specific event"
          }
        },
