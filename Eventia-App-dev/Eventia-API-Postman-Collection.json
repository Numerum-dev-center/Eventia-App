      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            { "listen": "test", "script": { "exec": [
              "var d = pm.response.json();",
              "if(d.id) pm.collectionVariables.set('userId', d.id);",
              "if(d.activationToken) pm.collectionVariables.set('activationCode', d.activationToken);"
            ]}}
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@test.com\",\n  \"password\": \"Test@1234\",\n  \"role\": \"Organizer\"\n}"
            }
          }
        },
        {
          "name": "Login Organizer",
          "event": [
            { "listen": "test", "script": { "exec": [
              "var d = pm.response.json();",
              "pm.collectionVariables.set('organizerToken', d.accessToken || '');"
            ]}}
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"organizer@test.com\",\n  \"password\": \"Test@1234\"\n}"
            }
          }
        },
