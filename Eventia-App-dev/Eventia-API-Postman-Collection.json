{
  "info": {
    "name": "Eventia Backend API",
    "_postman_id": "eventia-backend-collection",
    "description": "Collection complète de l'API backend Eventia — Plateforme Événementielle\n\n## Flow de test\n1. Inscrire un Client puis un Organisateur\n2. Login pour obtenir le token\n3. Utiliser le token dans Authorize\n4. Tester les routes dans l'ordre\n\n## Variables à configurer\n- `baseUrl` = http://localhost:3000\n- Le token est automatiquement sauvegardé après le login",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "organizerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "clientToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "organizerId", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "ticketCategoryId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "ticketId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "eventCategoryId", "value": "" },
    { "key": "promoCodeId", "value": "" },
    { "key": "commissionId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [

    {
      "name": "Auth",
      "description": "Inscription, connexion, activation, reset mot de passe",
      "item": [
        {
          "name": "1. Inscription Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('userId', json.id); }",
                  "console.log('Client ID:', pm.collectionVariables.get('userId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/Register-client", "host": ["{{baseUrl}}"], "path": ["auth", "Register-client"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"client@test.com\",\n  \"password\": \"Test@1234\",\n  \"confirmPassword\": \"Test@1234\"\n}"
            }
          }
        },
        {
          "name": "2. Inscription Organisateur",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('organizerId', json.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/Register-organisateur", "host": ["{{baseUrl}}"], "path": ["auth", "Register-organisateur"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"organizer@test.com\",\n  \"password\": \"Test@1234\",\n  \"confirmPassword\": \"Test@1234\"\n}"
            }
          }
        },
        {
          "name": "3. Connexion Client → Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) { pm.collectionVariables.set('token', json.accessToken); console.log('Token sauvegardé!'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/connexion", "host": ["{{baseUrl}}"], "path": ["auth", "connexion"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"client@test.com\",\n  \"password\": \"Test@1234\"\n}"
            }
          }
        },
        {
          "name": "4. Connexion Organisateur → Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) { pm.collectionVariables.set('organizerToken', json.accessToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/connexion", "host": ["{{baseUrl}}"], "path": ["auth", "connexion"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"organizer@test.com\",\n  \"password\": \"Test@1234\"\n}"
            }
          }
        },
        {
          "name": "4.1 Connexion Admin → Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) { pm.collectionVariables.set('adminToken', json.accessToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/connexion", "host": ["{{baseUrl}}"], "path": ["auth", "connexion"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@eventia.com\",\n  \"password\": \"Admin@1234\"\n}"
            }
          }
        },
        {
          "name": "5. Refresh Token",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/refreshtoken", "host": ["{{baseUrl}}"], "path": ["auth", "refreshtoken"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"<refresh_token>\"\n}" }
          }
        },
        {
          "name": "6. Mot de passe oublié",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"client@test.com\"\n}" }
          }
        },
        {
          "name": "7. Renvoyer code activation",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/resend-code", "host": ["{{baseUrl}}"], "path": ["auth", "resend-code"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"client@test.com\"\n}" }
          }
        },
        {
          "name": "8. Reset mot de passe",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"client@test.com\",\n  \"code\": \"123456\",\n  \"newPassword\": \"NewPass@1234\",\n  \"confirmPassword\": \"NewPass@1234\"\n}" }
          }
        },
        {
          "name": "9. Déconnexion",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/deconnexion", "host": ["{{baseUrl}}"], "path": ["auth", "deconnexion"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }]
          }
        }
      ]
    },

