    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "organizerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "clientToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "organizerProfileId", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "ticketCategoryId", "value": "" },
    { "key": "orderId", "value": "" },
