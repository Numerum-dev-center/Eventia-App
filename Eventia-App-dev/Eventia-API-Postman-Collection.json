    {
      "name": "03 - Organizer Routes",
      "description": "Routes dédiées à l'organisateur via /organizer/*",
      "item": [
        {
          "name": "My Events (organizer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (Array.isArray(json) && json.length > 0 && json[0].id) { pm.collectionVariables.set('eventId', json[0].id); console.log('First event ID:', json[0].id); }",
                  "console.log('Events count:', Array.isArray(json) ? json.length : 'not an array');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/organizer/events", "host": ["{{baseUrl}}"], "path": ["organizer", "events"] },
            "description": "List all events for the authenticated organizer"
          }
        },
        {
          "name": "Create Event (organizer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('eventId', json.id); console.log('Event ID:', json.id); }",
                  "console.log('Create event response:', JSON.stringify(json));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/organizer/events", "host": ["{{baseUrl}}"], "path": ["organizer", "events"] },
