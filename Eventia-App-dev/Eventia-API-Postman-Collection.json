            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Festival Afrobeat Lome 2026\",\n  \"description\": \"Le plus grand festival de musique afrobeat d'Afrique de l'Ouest\",\n  \"category\": \"Concert\",\n  \"locationType\": \"physical\",\n  \"maxCapacity\": 5000,\n  \"placeName\": \"Stade de Keque\",\n  \"adress\": \"Boulevard du 13 Janvier, Lome\",\n  \"longitude\": \"1.2255\",\n  \"latitude\": \"6.1256\",\n  \"startDate\": \"2026-12-20T20:00:00.000Z\",\n  \"endDate\": \"2026-12-21T04:00:00.000Z\",\n  \"bannerImage\": \"https://example.com/banner.jpg\",\n  \"ticketsCategories\": [\n    {\n      \"name\": \"Standard\",\n      \"price\": \"5000\",\n      \"totalQuantity\": 500,\n      \"limitByPerson\": 4\n    },\n    {\n      \"name\": \"VIP\",\n      \"price\": \"15000\",\n      \"totalQuantity\": 100,\n      \"limitByPerson\": 2\n    }\n  ]\n}"
            },
            "description": "Create a new event with ticket categories inline"
          }
        },
        {
