{
  "info": {
    "name": "Eventia Backend API",
    "_postman_id": "eventia-backend-collection-v2",
    "description": "Collection complète de l'API backend Eventia — Plateforme Événementielle\n\n## Flow de test (step-by-step)\n1. Inscrire un Organisateur → recevoir le code d'activation\n2. Activer le compte via POST /user/:id/activate\n3. Login Organisateur → obtenir organizerToken\n4. Mettre à jour le profil organisateur (societyName requis)\n5. Créer un événement via POST /organizer/events\n6. Ajouter des catégories de billets\n7. Publier l'événement\n8. Tester le dashboard organisateur\n\n## Identifiants de test\n- Admin: admin@eventia.com / Admin@1234\n- Organizer: organizer@test.com / Test@1234\n- Client: client@test.com / Test@1234\n\n## Variables\n- `baseUrl` = https://eventia-app-c6b5.onrender.com\n- Les tokens sont sauvegardés automatiquement après login",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://eventia-app-c6b5.onrender.com" },
    { "key": "token", "value": "" },
    { "key": "organizerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "organizerProfileId", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "ticketCategoryId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "ticketId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "eventCategoryId", "value": "" },
    { "key": "promoCodeId", "value": "" },
    { "key": "commissionId", "value": "" },
    { "key": "newOrganizerId", "value": "" },
    { "key": "activationCode", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [

    {
      "name": "00 - STEP-BY-STEP TEST GUIDE",
      "description": "Suivre ces étapes dans l'ordre pour tester le backend",
      "item": [
        {
          "name": "01 - Register Organizer (creates inactive account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "console.log('Response:', JSON.stringify(json));",
                  "if (json.id) { pm.collectionVariables.set('newOrganizerId', json.id); console.log('New organizer ID:', json.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/register-organizer", "host": ["{{baseUrl}}"], "path": ["auth", "register-organizer"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"neworganizer@test.com\",\n  \"password\": \"Test@1234\",\n  \"confirmPassword\": \"Test@1234\"\n}"
            },
            "description": "Step 1: Create a new organizer account (inactive by default)"
          }
        },
        {
          "name": "02 - Activate Organizer via code (check DB for code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "console.log('Activation response:', JSON.stringify(json));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/user/{{newOrganizerId}}/activate", "host": ["{{baseUrl}}"], "path": ["user", "{{newOrganizerId}}", "activate"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{activationCode}}\"\n}"
            },
            "description": "Step 2: Activate the account with the 6-digit code from DB. Replace {{activationCode}} with actual code."
          }
        },
        {
          "name": "03 - Login Organizer → get token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) { pm.collectionVariables.set('organizerToken', json.accessToken); console.log('Organizer token saved!'); }",
                  "console.log('Login response:', JSON.stringify(json));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"organizer@test.com\",\n  \"password\": \"Test@1234\"\n}"
            },
            "description": "Step 3: Login as organizer to get JWT token"
          }
        },
        {
          "name": "04 - Update Organizer Profile (create society)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.organizerProfile) { pm.collectionVariables.set('organizerProfileId', json.organizerProfile.id); console.log('Profile ID:', json.organizerProfile.id); }",
                  "console.log('Profile response:', JSON.stringify(json));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/user/me/profil-organisateur", "host": ["{{baseUrl}}"], "path": ["user", "me", "profil-organisateur"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lastName\": \"Koffi\",\n  \"firstName\": \"Kofi\",\n  \"organizerProfile\": {\n    \"societyName\": \"EventCorp Togo\",\n    \"brand\": \"EventCorp\",\n    \"description\": \"Organisateur d'événements à Lomé\"\n  }\n}"
            },
            "description": "Step 4: Update organizer profile (creates organizerProfile if missing)"
          }
        },
        {
          "name": "05 - Get My Organizer Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/organizer-profile/me", "host": ["{{baseUrl}}"], "path": ["organizer-profile", "me"] },
            "description": "Verify organizer profile was created"
          }
        }
      ]
    },

